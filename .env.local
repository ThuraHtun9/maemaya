# Change these values before production deployment
# Example: DOMAIN=maemaya.com
DOMAIN=localhost

ADMIN_USERNAME=admin
# Plain password (min 10 chars) OR bcrypt value like {bcrypt}$2a$...
ADMIN_PASSWORD=admin

# Shared DB settings (for PostgreSQL or MySQL)
DB_NAME=springshop
DB_USER=springshop
DB_PASSWORD=springshop

# Only used for MySQL stack
MYSQL_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD
