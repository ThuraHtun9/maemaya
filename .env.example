# Change these values before production deployment
#  DOMAIN=mae-maya.com
DOMAIN=shop.example.com

ADMIN_USERNAME=admin
# Plain password (min 10 chars) OR bcrypt value like {bcrypt}$2a$...
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# Shared DB settings (for PostgreSQL or MySQL)
DB_NAME=springshop
DB_USER=springshop
DB_PASSWORD=CHANGE_THIS_DB_PASSWORD

# Only used for MySQL stack
MYSQL_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD
